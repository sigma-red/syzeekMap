# Elasticsearch connection settings
ES_HOST=https://your-security-onion-ip:9200
ES_USERNAME=elastic
ES_PASSWORD=your-password
ES_VERIFY_CERTS=false

# Index patterns (Security Onion defaults)
# These patterns cover both IT and OT/ICS protocol logs (Modbus, DNP3, S7comm, BACnet, EtherNet/IP)
# Zeek ICS protocol analyzers must be enabled in Security Onion for OT visibility
ZEEK_INDEX_PATTERN=*:so-zeek-*
SYSMON_INDEX_PATTERN=*:so-sysmon-*

# Polling interval in seconds
POLL_INTERVAL=30

# Web server settings
HOST=0.0.0.0
PORT=8080
